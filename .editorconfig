root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.glsl]
indent_size = 4

# Keep the vendored shader byte-for-byte compatible with upstream.
[ghostty/shaders/cursor_warp.glsl]
trim_trailing_whitespace = false

[*.md]
max_line_length = 100

[*.png]
insert_final_newline = false
trim_trailing_whitespace = false
